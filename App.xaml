<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Exdir.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Exdir.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 必须放在 XamlControlsResources 之后：后合并的字典优先级更高 -->
                <ResourceDictionary Source="Themes/ExdirTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器 -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:CloudSyncStateVisibilityConverter x:Key="SyncStateVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

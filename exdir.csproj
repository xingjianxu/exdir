<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Exdir</RootNamespace>
    <AssemblyName>exdir</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\exdir.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    ===========================================================================
    非打包（unpackaged）部署模式
    ===========================================================================
    WindowsPackageType=None         -> 不生成 MSIX，直接产出可双击运行的 exe
    WindowsAppSDKSelfContained=true -> 把 WindowsAppSDK 运行时随程序一起输出，
                                       目标机器无需预装 Windows App Runtime
  -->
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- WinAppSDK 自包含需要 .NET 也自包含，否则运行时初始化器会去激活未注册的 WinRT 类 -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      自定义入口点（Program.cs）。关掉 XAML 生成的 Main 是为了把「单实例闸门」放在
      XAML/WinUI 初始化之前：exdir 常驻托盘，用户第二次双击 exe 时应该只置位一个内核事件
      就退出，而不是白跑一遍 WinUI 初始化再退出。Program.cs 里的 Main 与
      obj\<平台>\<配置>\<TFM>\<RID>\App.g.i.cs 里 XAML 生成的版本逐行一致，只是多这一层判断。
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    Publish 相关
    ============
    PublishTrimmed / PublishReadyToRun 必须关闭：
      * 裁剪会让 XAML 反射查找控件类型失败；
      * ReadyToRun 则会让生成的 XamlTypeInfo 在启动时抛 XamlParseException
        （实测 Release 直接构建可用，但 publish 出 R2R 后无法启动）。
  -->
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- 非打包部署下资源文件需要显式复制到输出目录 -->
  <ItemGroup>    <Content Include="Assets\exdir.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SplashScreen.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\LockScreenLogo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\StoreLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    dist\ 里也有 Assets\*.png（发布产物），而构建时会有 **\*.png 之类的默认通配把它们当作内容
    复制到输出目录，于是 bin 里多出一份 dist，publish.ps1 再把它镜像回 dist\win-x64，
    形成越发布越深的 dist\win-x64\dist\win-x64\... 自我嵌套。这里把产物目录排除掉。
  -->
  <ItemGroup>
    <Content Remove="dist\**" />
    <Content Remove=".artifacts\**" />
    <None Remove="dist\**" />
    <None Remove=".artifacts\**" />
    <PRIResource Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
  </ItemGroup>

  <!--
    ===========================================================================
    为什么不用 dotnet publish
    ===========================================================================
    实测在本项目（WinUI 3 + 非打包）下 `dotnet publish` 会丢掉 XAML 编译器生成的
    .xbf（编译后的 XAML）和应用资源索引 exdir.pri：它们只有 CopyToOutputDirectory，
    没有被加入发布文件列表。缺了它们，发布版启动时
    MainWindow.InitializeComponent() 会抛 XamlParseException（“XAML parsing failed”）。
    尝试用自定义 target 手动补进 ResolvedFileToPublish 反而把整个发布目录写坏
    （所有文件都被写成同一个 xbf 的内容），因此不用 publish。

    正确的发布流程见 tools\publish.ps1：
    先用 dotnet build 做 Release 构建（带 -r win-x64 与 self-contained 开关），
    再把构建输出镜像到 dist\win-x64。构建输出里这些文件是齐全的，可直接双击运行。
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      设置窗口里的 SettingsCard / SettingsExpander —— Windows 11 设置界面的卡片式行布局。
      版本锁 8.2.251219（8.x 里最后一个稳定版）：它出 net8.0-windows10.0.19041 目标，
      依赖 Microsoft.WindowsAppSDK >= 1.6（本项目是 2.5.1，向上兼容）。
      8.3.x 只有 preview，暂不跟。
    -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!--
      托盘图标（WinUI 3 自身没有托盘 API，见 AGENTS.md 第 4 节“托盘驻留”）。
      图标本体走 Shell_NotifyIcon，不需要包标识，非打包部署可用；
      版本锁在 2.3.2：它是最后一个支持 net8.0-windows 的版本（2.4.x 只出 net10.0）。
    -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>

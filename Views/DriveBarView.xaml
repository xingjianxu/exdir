<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Exdir.Views.DriveBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Exdir.Models"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Height="{StaticResource ExToolbarHeight}"
        Padding="6,0,6,0"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1"
        ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左：磁盘 / 网络盘 / 可移动盘 -->
        <ScrollViewer
            Grid.Column="0"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DriveModel">
                        <Button
                            AutomationProperties.Name="{x:Bind ToolbarText}"
                            Click="DriveButton_Click"
                            Style="{StaticResource ExToolbarButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Tooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind ToolbarText}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 右：固定目录（拖放区，可从列表/侧边栏把目录拖过来固定） + 快捷菜单 -->
        <Grid Grid.Column="1" ColumnSpacing="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- AllowDrop 必须配 Background（哪怕是 Transparent）才有命中区，
                 否则空白处拿不到 DragOver/Drop。高亮层是 Grid 的第一个子元素，
                 画在按钮下面（只露出一圈强调色边框 + 淡淡的底色），自身设为不可命中。 -->
            <Border
                x:Name="PinnedDropZone"
                Grid.Column="0"
                MinWidth="26"
                MinHeight="26"
                Padding="4,2,4,2"
                AllowDrop="True"
                AutomationProperties.Name="固定目录"
                Background="Transparent"
                DragLeave="PinnedDropZone_DragLeave"
                DragOver="PinnedDropZone_DragOver"
                Drop="PinnedDropZone_Drop">
                <Grid x:Name="PinnedItemsHost">
                    <Border
                        x:Name="DropHighlight"
                        BorderThickness="1"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
                        </Border.Background>
                    </Border>

                    <ItemsControl x:Name="PinnedItems" ItemsSource="{x:Bind ViewModel.PinnedFolders, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PinnedFolderViewModel">
                                <!-- 按住按钮拖到兄弟按钮上就是排序（手势由 PinnedItemsHost 的 code-behind 监听识别，
                                     因为 Button 会把左键的指针事件标成 Handled，CanDrag 在这里不生效） -->
                                <Button
                                    AutomationProperties.Name="{x:Bind Name}"
                                    CanDrag="True"
                                    Click="PinnedButton_Click"
                                    ContextRequested="PinnedButton_ContextRequested"
                                    DragStarting="PinnedButton_DragStarting"
                                    DropCompleted="PinnedButton_DropCompleted"
                                    Style="{StaticResource ExToolbarButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 排序时的插入位置提示：2px 强调色竖条，位置由 code-behind 按相邻按钮的边界设置 -->
                    <Border
                        x:Name="InsertionIndicator"
                        Width="2"
                        Margin="0,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        CornerRadius="1"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Border.Background>
                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <Button
                x:Name="QuickMenuButton"
                Grid.Column="1"
                MinWidth="30"
                Padding="6,1,6,1"
                AutomationProperties.Name="快捷菜单"
                Style="{StaticResource ExToolbarButtonStyle}"
                ToolTipService.ToolTip="快捷菜单">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="QuickMenuFlyout" Opening="QuickMenuFlyout_Opening" />
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<!--
  设置窗口（「配置 → 设置…」）：一层薄壳，只负责默认尺寸/位置、标题与“改动即时生效”的接线，
  界面本体在 Views/SettingsView（左导航 + Windows 11 风格的设置卡片）。

  为什么正文不直接写在这里：Window 不是 FrameworkElement，WinUI 生成的 x:Bind 代码在 Window
  这一层做不了 {StaticResource} 转换器查找（会直接编译失败 CS1503），而设置页要用 BoolToVisibility。
-->
<Window
    x:Class="Exdir.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Exdir.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="设置">

    <!-- Mica 背板：不只为好看 —— NavigationView 的窗格（左侧导航）用的是半透明的应用内亚克力，
         窗口背后没有背板时它采样到的是窗口自身的黑色底，浅色主题下就成了一块黑底 + 深色文字。
         加上背板后窗格跟主窗口的侧边栏一样是 Mica（深 / 浅都跟着主题走）。 -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <views:SettingsView x:Name="View" />
</Window>

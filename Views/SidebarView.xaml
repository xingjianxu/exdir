<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Exdir.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="12,8,8,4"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="文件夹" />

        <TreeView
            x:Name="FolderTree"
            Grid.Row="1"
            Padding="4,0,4,8"
            CanDragItems="True"
            CanReorderItems="False"
            DragItemsStarting="FolderTree_DragItemsStarting"
            Expanding="FolderTree_Expanding"
            ItemInvoked="FolderTree_ItemInvoked"
            ItemsSource="{x:Bind ViewModel.Roots, Mode=OneWay}"
            SelectionMode="Single">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarNodeViewModel">
                    <TreeViewItem
                        AutomationProperties.Name="{x:Bind Name}"
                        AllowDrop="True"
                        ContextRequested="SidebarItem_ContextRequested"
                        DragLeave="SidebarItem_DragLeave"
                        DragOver="SidebarItem_DragOver"
                        HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=TwoWay}"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        ItemsSource="{x:Bind Children}"
                        ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <Grid>
                            <!-- 拖拽落点高亮：只有悬停在「收藏夹」分组或其行上时才出现（见 SidebarView.xaml.cs） -->
                            <Border
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind IsDropTarget, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
                                </Border.Background>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>

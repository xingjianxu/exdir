<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Exdir.Views.NavigationBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Exdir.Views"
    mc:Ignorable="d">

    <!-- 每个标签页独占一份：历史与路径输入都跟着标签页走 -->
    <Grid
        Height="30"
        Padding="4,0,6,0"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1"
        ColumnSpacing="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
            <Button
                Width="28"
                Height="26"
                Padding="0"
                AutomationProperties.Name="后退"
                Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                Style="{StaticResource ExToolbarButtonStyle}"
                ToolTipService.ToolTip="后退 (Alt+←)">
                <FontIcon FontSize="13" Glyph="&#xE72B;" />
            </Button>
            <Button
                Width="28"
                Height="26"
                Padding="0"
                AutomationProperties.Name="前进"
                Command="{x:Bind ViewModel.GoForwardCommand, Mode=OneWay}"
                Style="{StaticResource ExToolbarButtonStyle}"
                ToolTipService.ToolTip="前进 (Alt+→)">
                <FontIcon FontSize="13" Glyph="&#xE72A;" />
            </Button>
            <Button
                Width="28"
                Height="26"
                Padding="0"
                AutomationProperties.Name="上一级"
                Command="{x:Bind ViewModel.GoUpCommand, Mode=OneWay}"
                Style="{StaticResource ExToolbarButtonStyle}"
                ToolTipService.ToolTip="上一级 (Alt+↑)">
                <FontIcon FontSize="13" Glyph="&#xE74A;" />
            </Button>
            <Button
                Width="28"
                Height="26"
                Padding="0"
                AutomationProperties.Name="刷新"
                Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                Style="{StaticResource ExToolbarButtonStyle}"
                ToolTipService.ToolTip="刷新 (F5)">
                <FontIcon FontSize="13" Glyph="&#xE72C;" />
            </Button>
        </StackPanel>

        <!-- 地址栏：面包屑分段（可点击）+ 点空白处切到可编辑输入框，见 Views/PathBreadcrumb -->
        <views:PathBreadcrumb Grid.Column="1" ViewModel="{x:Bind ViewModel}" />

        <!-- Everything 快速搜索：输入去抖后自动搜，结果替换本标签页的列表（见 AGENTS.md 第 4 节）。
             默认范围 = 当前目录（含子目录），旁边的「整机」开关切到全部索引。 -->
        <views:SearchBarView
            Grid.Column="2"
            Margin="4,0,0,0"
            ViewModel="{x:Bind ViewModel}" />

        <!-- 压缩包里是只读浏览（见 AGENTS.md 第 4 节）：贴在地址栏右边的提醒。
             放在导航条而不是状态栏，是因为状态栏三段文本的断言是“内容即文本”。 -->
        <StackPanel
            Grid.Column="3"
            Margin="6,0,2,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="只读压缩包"
            Spacing="4"
            Visibility="{x:Bind ViewModel.IsInsideArchive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xF012;" />
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="只读" />
        </StackPanel>
    </Grid>
</UserControl>

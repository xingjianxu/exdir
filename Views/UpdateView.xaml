<?xml version="1.0" encoding="utf-8"?>
<!--
  更新窗口（Views/UpdateWindow）的正文。

  正文是 UserControl 而不是直接写在 Window 里：Window 不是 FrameworkElement，
  它这一层的 x:Bind 用不了 {StaticResource} 转换器（编译报 CS1503），
  而这里要用 BoolToVisibility 控制按钮与提示的显隐（同 Views/SettingsView，见 AGENTS.md 第 6 节第 50 条）。
-->
<UserControl
    x:Class="Exdir.Views.UpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="更新 exdir" />

        <StackPanel Grid.Row="1" Spacing="2">
            <!-- 这两个 TextBlock **故意不给 AutomationProperties.Name**：这样它们在 UIA 里的名字
                 就是自己的文本（“当前版本：0.0.20261001”），回归脚本直接按文本断言
                 （同状态栏那条约定，见 AGENTS.md 第 4 节“文件列表区底部一条状态栏”）。 -->
            <TextBlock
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}" />
            <TextBlock
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.LatestVersionText, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="更新会下载发布包并校验 SHA256，然后退出 exdir、替换安装目录里的文件并自动重启。你的设置与「最新访问」记录都不在安装目录里，不会被覆盖。"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SelfUpdateHint, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasSelfUpdateHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 发行说明：可滚动（Release 说明里有变更清单与校验值，长短不一定） -->
        <Border
            Grid.Row="3"
            MinHeight="120"
            Padding="10,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock
                    FontSize="12"
                    Text="{x:Bind ViewModel.ReleaseNotesText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Spacing="6">
            <ProgressBar
                AutomationProperties.Name="下载进度"
                Maximum="1"
                Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel
            Grid.Row="5"
            Margin="0,6,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                AutomationProperties.Name="重新检查更新"
                Command="{x:Bind ViewModel.CheckCommand}"
                Content="重新检查" />
            <Button
                AutomationProperties.Name="打开发布页"
                Command="{x:Bind ViewModel.OpenReleasePageCommand}"
                Content="打开发布页" />
            <Button
                AutomationProperties.Name="取消下载"
                Command="{x:Bind ViewModel.CancelDownloadCommand}"
                Content="取消下载"
                Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Button
                AutomationProperties.Name="下载更新"
                Command="{x:Bind ViewModel.DownloadCommand}"
                Content="立即更新"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.ShowDownloadButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Button
                AutomationProperties.Name="重启并完成更新"
                Command="{x:Bind ViewModel.RestartCommand}"
                Content="重启并完成更新"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.ShowRestartButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Button
                AutomationProperties.Name="稍后"
                Click="Close_Click"
                Content="稍后" />
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Exdir.Views.DetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Exdir.Controls"
    xmlns:helpers="using:Exdir.Helpers"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== 列头 =====================
             列宽来自 ViewModel.Columns（本标签页共享），拖动把手由 code-behind 放进 HeaderContent。
             HeaderContent 会跟随列表的横向滚动一起平移（见 code-behind），HeaderRow 负责裁剪。 -->
        <Grid
            x:Name="HeaderRow"
            Grid.Row="0"
            Height="{StaticResource ExListHeaderHeight}"
            Padding="{StaticResource ExRowPadding}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            SizeChanged="HeaderRow_SizeChanged">
            <Grid x:Name="HeaderContent">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HeaderTransform" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind ViewModel.Columns.NameWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind ViewModel.Columns.DateWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind ViewModel.Columns.TypeWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind ViewModel.Columns.SizeWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Height="24"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                    CommandParameter="Name"
                    AutomationProperties.Name="按名称排序">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="12" Text="名称" />
                        <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    Height="24"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                    CommandParameter="LastWriteTime"
                    AutomationProperties.Name="按修改日期排序">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="12" Text="修改日期" />
                        <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.DateSortGlyph, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Height="24"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                    CommandParameter="Type"
                    AutomationProperties.Name="按类型排序">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="12" Text="类型" />
                        <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.TypeSortGlyph, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="3"
                    Height="24"
                    Padding="0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                    CommandParameter="Size"
                    AutomationProperties.Name="按大小排序">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="12" Text="大小" />
                        <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}" />
                    </StackPanel>
                </Button>

            <!-- 列宽拖动把手由 code-behind 追加到 HeaderContent.Children（比按钮后加，所以在最上层） -->
            </Grid>
        </Grid>

        <!-- ===================== 列表 ===================== -->
        <ListView
            x:Name="EntryList"
            Grid.Row="1"
            Padding="0"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            Loaded="EntryList_Loaded"
            SelectionChanged="EntryList_SelectionChanged"
            SelectionMode="Extended"
            SizeChanged="EntryList_SizeChanged"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="{StaticResource ExRowHeight}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileItemViewModel">
                    <Grid
                        Height="{StaticResource ExRowHeight}"
                        MinWidth="{x:Bind Columns.RowMinWidth, Mode=OneWay}"
                        Padding="{StaticResource ExRowPadding}"
                        AutomationProperties.Name="{x:Bind DisplayName}"
                        DoubleTapped="Row_DoubleTapped"
                        ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Columns.NameWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.DateWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.TypeWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.SizeWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 名称列：缩进占位 + 展开箭头 + 图标 + 文本 -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="{x:Bind IndentWidth, Mode=OneWay}" />

                            <Button
                                Grid.Column="1"
                                Width="18"
                                Height="18"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="Expander_Click"
                                IsHitTestVisible="{x:Bind CanExpand, Mode=OneWay}"
                                AutomationProperties.Name="展开或折叠">
                                <FontIcon
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" />
                            </Button>

                            <FontIcon
                                Grid.Column="2"
                                Margin="0,0,6,0"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind Glyph}" />

                            <TextBlock
                                Grid.Column="3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ModifiedText}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind TypeName}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind SizeText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ===================== 空目录提示 ===================== -->
        <TextBlock
            Grid.Row="1"
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="此文件夹为空"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!-- ===================== 加载指示 ===================== -->
        <ProgressRing
            Grid.Row="1"
            Width="24"
            Height="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!-- ===================== 错误提示 ===================== -->
        <InfoBar
            Grid.Row="2"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Warning"
            Title="无法打开" />

        <!-- ===================== 选中摘要 ===================== -->
        <Grid
            Grid.Row="3"
            Height="22"
            Padding="8,0,8,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>

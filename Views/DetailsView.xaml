<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Exdir.Views.DetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Exdir.Controls"
    xmlns:helpers="using:Exdir.Helpers"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="DetailsRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <!-- Ctrl+A 全选本列表的行（就地展开出来的子行也算，它们就是列表里的行）。
             挂在这一层而不是 ListView 上，是为了让焦点在列头按钮 / 行内展开箭头时也生效；
             地址栏在 NavigationBarView 里，不在本控件内，所以那里的 Ctrl+A 仍然是文本框全选。 -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== 列头 =====================
             列宽来自 ViewModel.Columns（本标签页共享），拖动把手由 code-behind 放进 HeaderLayer。
             HeaderLayer 会跟随列表的横向滚动一起平移（见 code-behind），HeaderRow 负责裁剪。 -->
        <Grid
            x:Name="HeaderRow"
            Grid.Row="0"
            Height="{StaticResource ExListHeaderHeight}"
            Padding="{StaticResource ExRowPadding}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            SizeChanged="HeaderRow_SizeChanged">
            <!--
                把手层：本身**没有列定义**（整层就是一列 = 表头整宽），拖动把手由 code-behind 追加在这里，
                水平位置用 RenderTransform 推。
                为什么不把把手直接放进下面那个带列定义的 HeaderContent：它的第 0 列是“状态”列，
                非云目录里宽度为 0，而**零宽单元格里的子元素收不到指针事件**（实测：把手既不响应悬停、
                也拖不动，见 AGENTS.md“踩过的坑”），所以把手必须待在一个整宽的父层里。
                横向滚动的平移挂在**这一层**上，于是按钮与把手一起平移。
            -->
            <Grid x:Name="HeaderLayer">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HeaderTransform" />
                </Grid.RenderTransform>

                <!-- 数据列：列定义 + 铺满整列的排序按钮（列宽与数据行绑定的是同一份 rendered 宽度） -->
                <Grid x:Name="HeaderContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind ViewModel.Columns.SyncStateWidth, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Columns.NameWidth, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Columns.DateWidth, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Columns.TypeWidth, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Columns.SizeWidth, Mode=OneWay}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 同步状态列只在云同步目录里出现（宽度为 0 时这里也隐藏，免得留下一个点不到的排序按钮）。
                         列头按钮铺满整列：整列宽度 + 整个表头高度都是排序的命中区（见 ExColumnHeaderButtonStyle）。 -->
                    <Button
                        x:Name="SyncStateHeader"
                        Grid.Column="0"
                        Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                        CommandParameter="SyncState"
                        Style="{StaticResource ExColumnHeaderButtonStyle}"
                        Visibility="{x:Bind ViewModel.Columns.ShowSyncColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="按同步状态排序">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontSize="12" Text="状态" />
                            <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.SyncStateSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="NameHeader"
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                        CommandParameter="Name"
                        Style="{StaticResource ExColumnHeaderButtonStyle}"
                        AutomationProperties.Name="按名称排序">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontSize="12" Text="名称" />
                            <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="DateHeader"
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                        CommandParameter="LastWriteTime"
                        Style="{StaticResource ExColumnHeaderButtonStyle}"
                        AutomationProperties.Name="按修改日期排序">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontSize="12" Text="修改日期" />
                            <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.DateSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="TypeHeader"
                        Grid.Column="3"
                        Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                        CommandParameter="Type"
                        Style="{StaticResource ExColumnHeaderButtonStyle}"
                        AutomationProperties.Name="按类型排序">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontSize="12" Text="类型" />
                            <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.TypeSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- “大小”列里的数字是靠右的，所以列头文字也靠右，否则悬停整列时会觉得标签飘在中间 -->
                    <Button
                        x:Name="SizeHeader"
                        Grid.Column="4"
                        HorizontalContentAlignment="Right"
                        Command="{x:Bind ViewModel.SortByCommand, Mode=OneWay}"
                        CommandParameter="Size"
                        Style="{StaticResource ExColumnHeaderButtonStyle}"
                        AutomationProperties.Name="按大小排序">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontSize="12" Text="大小" />
                            <FontIcon FontSize="9" Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 列宽拖动把手由 code-behind 追加到 HeaderLayer.Children（在按钮层之上） -->
            </Grid>
        </Grid>

        <!-- ===================== 列表 ===================== -->
        <ListView
            x:Name="EntryList"
            Grid.Row="1"
            Padding="0"
            CanDragItems="True"
            CanReorderItems="False"
            ContainerContentChanging="EntryList_ContainerContentChanging"
            DragItemsStarting="EntryList_DragItemsStarting"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            Loaded="EntryList_Loaded"
            SelectionChanged="EntryList_SelectionChanged"
            SelectionMode="Extended"
            SizeChanged="EntryList_SizeChanged"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <!--
                        行高不再由容器锁死：它由设置决定，绑在下面行模板的 Grid.Height 上。
                        这里必须归零（默认的 ListViewItemMinHeight=24），否则把行高调到 24 以下就不生效。
                        列头行（ExListHeaderHeight=26）不跟着变，仍然是紧凑表头。
                    -->
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileItemViewModel">
                    <!--
                        行高 = 设置里的「行高」（Columns 是本标签页共享的布局对象，见 ColumnLayout.RowHeight）。
                        行内每一格仍然 VerticalAlignment=Center，所以行高只改变上下留白：
                        图标与名称文字始终在行内垂直居中（图标的 1 DIP 下推见下）。
                    -->
                    <!--
                        Background 必须是透明画刷（哪怕是 Transparent）：没有背景的 Grid 在“空白处”
                        不参与命中测试，那样的区域会落到 ListViewItem 上，整行就只有文字/图标
                        那几小块能双击、能弹提示框。
                        双击本身不在这里处理，挂在最外层 Grid 上（见 code-behind）。
                    -->
                    <Grid
                        Height="{x:Bind Columns.RowHeight, Mode=OneWay}"
                        MinWidth="{x:Bind Columns.RowMinWidth, Mode=OneWay}"
                        Padding="{StaticResource ExRowPadding}"
                        Background="Transparent"
                        AutomationProperties.Name="{x:Bind DisplayName}"
                        ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Columns.SyncStateWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.NameWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.DateWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.TypeWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.SizeWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 同步状态：一格只可能显示一个字形（其余都折叠），字形即状态，颜色走主题资源。
                             用 TextBlock 而不是 FontIcon，是因为 TextBlock 会进 UIA 树，
                             自动化脚本能直接读到“仅在云端 / 已同步”这样的状态名。 -->
                        <Grid
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind SyncStateTooltip, Mode=OneWay}">
                            <TextBlock
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Text="{x:Bind SyncStateGlyph, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind SyncStateText, Mode=OneWay}"
                                Visibility="{x:Bind SyncState, Mode=OneWay, Converter={StaticResource SyncStateVisibility}, ConverterParameter=Synced}" />
                            <TextBlock
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Text="{x:Bind SyncStateGlyph, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind SyncStateText, Mode=OneWay}"
                                Visibility="{x:Bind SyncState, Mode=OneWay, Converter={StaticResource SyncStateVisibility}, ConverterParameter=Pinned}" />
                            <TextBlock
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SyncStateGlyph, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind SyncStateText, Mode=OneWay}"
                                Visibility="{x:Bind SyncState, Mode=OneWay, Converter={StaticResource SyncStateVisibility}, ConverterParameter=CloudOnly}" />
                            <TextBlock
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind SyncStateGlyph, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind SyncStateText, Mode=OneWay}"
                                Visibility="{x:Bind SyncState, Mode=OneWay, Converter={StaticResource SyncStateVisibility}, ConverterParameter=Syncing}" />
                            <TextBlock
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind SyncStateGlyph, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind SyncStateText, Mode=OneWay}"
                                Visibility="{x:Bind SyncState, Mode=OneWay, Converter={StaticResource SyncStateVisibility}, ConverterParameter=Error}" />
                            <TextBlock
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="{x:Bind SyncStateGlyph, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind SyncStateText, Mode=OneWay}"
                                Visibility="{x:Bind SyncState, Mode=OneWay, Converter={StaticResource SyncStateVisibility}, ConverterParameter=Excluded}" />
                        </Grid>

                        <!-- 名称列：缩进占位 + 展开箭头 + 图标 + 文本 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="{x:Bind IndentWidth, Mode=OneWay}" />

                            <Button
                                Grid.Column="1"
                                Width="18"
                                Height="18"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                Click="Expander_Click"
                                IsHitTestVisible="{x:Bind CanExpand, Mode=OneWay}"
                                AutomationProperties.Name="展开或折叠"
                                Style="{StaticResource ExFlatSubtleButtonStyle}">
                                <FontIcon
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" />
                            </Button>

                            <!-- 图标：真实外壳图标（异步补上），拿到之前先用字形占位。
                                 两者固定 16×16 重叠摆放，所以换成真图标时行内不会跳动。 -->
                            <Grid Grid.Column="2" Width="16" Height="16" Margin="0,0,6,0">
                                <Grid.RenderTransform>
                                    <!-- 图标盒子本身是精确居中的，但文字的行盒下方还有一段降部（descent）空白，
                                         字形的视觉重心比行盒中心低约 1 DIP。下推 1 DIP 去对文字的视觉中心，
                                         而不是去对它的行盒中心（用 RenderTransform 是为了不影响行高与列宽）。 -->
                                    <TranslateTransform Y="1" />
                                </Grid.RenderTransform>
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind Glyph}"
                                    Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Image
                                    Width="16"
                                    Height="16"
                                    AutomationProperties.Name="程序图标"
                                    Source="{x:Bind Icon, Mode=OneWay}"
                                    Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <TextBlock
                                Grid.Column="3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ModifiedText}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind TypeName}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind SizeText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ===================== 空目录提示 ===================== -->
        <TextBlock
            Grid.Row="1"
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="此文件夹为空"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!-- ===================== 加载指示 ===================== -->
        <ProgressRing
            Grid.Row="1"
            Width="24"
            Height="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!-- ===================== 错误提示 ===================== -->
        <InfoBar
            Grid.Row="2"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Warning"
            Title="无法打开" />

        <!-- 状态栏不在这个控件里：它是全窗口一条（文件列表区底部），见 Views/StatusBarView -->
    </Grid>
</UserControl>


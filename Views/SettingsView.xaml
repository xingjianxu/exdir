<?xml version="1.0" encoding="utf-8"?>
<!--
  设置窗口的正文：左侧 NavigationView 选分类，右侧一列 Windows 11 风格的设置卡片
  （CommunityToolkit 的 SettingsCard：标题 + 灰色说明 + 右侧控件），不再自己写行模板 ——
  间距、圆角、悬停、高对比主题都跟着系统走。分类页用 Visibility 切换（非当前页 UIA 树里也读不到）。

  为什么正文是 UserControl 而不是直接写在 Window 里：
  1. Window 不是 FrameworkElement，WinUI 生成的 x:Bind 代码在 Window 这一层做不了
     {StaticResource} 转换器查找（编译期直接报 CS1503），而窗口正文到处要用 BoolToVisibility；
  2. 与仓库里其它 UserControl 一致：ViewModel 是依赖属性，由父级赋值。
-->
<UserControl
    x:Class="Exdir.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="Nav"
        CompactPaneLength="48"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        MenuItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
        OpenPaneLength="180"
        PaneDisplayMode="Left"
        SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItemTemplate>
            <!-- NavigationView 的菜单项模板根必须是 NavigationViewItem（和 TabView / TreeView 同理） -->
            <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                <NavigationViewItem Content="{x:Bind Name}" />
            </DataTemplate>
        </NavigationView.MenuItemTemplate>

        <ScrollViewer Padding="24,8,24,24" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- ============================ 文件列表 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsFileListPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="文件列表" />

                    <controls:SettingsCard Description="显示以 . 开头、带隐藏或系统属性的项目" Header="显示隐藏文件">
                        <ToggleSwitch
                            AutomationProperties.Name="显示隐藏文件"
                            IsOn="{x:Bind ViewModel.ShowHiddenFiles, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="在文件名后显示 .txt / .png 等扩展名" Header="显示文件扩展名">
                        <ToggleSwitch
                            AutomationProperties.Name="显示文件扩展名"
                            IsOn="{x:Bind ViewModel.ShowExtensions, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="排序时文件夹始终排在文件之前" Header="文件夹排在文件前面">
                        <ToggleSwitch
                            AutomationProperties.Name="文件夹排在文件前面"
                            IsOn="{x:Bind ViewModel.FoldersFirst, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <!-- 行高是连续值，用滑块；右侧常驻当前数值（UIA 名字就是数字本身） -->
                    <controls:SettingsCard Description="文件列表每一行的高度；图标与名称始终在行内垂直居中" Header="行高">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider
                                x:Name="RowHeightSlider"
                                Width="160"
                                AutomationProperties.Name="行高"
                                IsThumbToolTipEnabled="False"
                                Maximum="{x:Bind ViewModel.RowHeightMaximum, Mode=OneWay}"
                                Minimum="{x:Bind ViewModel.RowHeightMinimum, Mode=OneWay}"
                                StepFrequency="{x:Bind ViewModel.RowHeightStep, Mode=OneWay}"
                                Value="{x:Bind ViewModel.RowHeight, Mode=TwoWay}" />
                            <TextBlock
                                x:Name="RowHeightValue"
                                Width="24"
                                VerticalAlignment="Center"
                                TextAlignment="Right" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- 右键「压缩」生成的 zip 放哪里。可直接手填路径（粘贴也行），也可以用「浏览…」弹外壳的文件夹选择器；
                         留空 = 用户的「下载」文件夹。UpdateSourceTrigger=PropertyChanged 让改动落在“每一次按键”上，
                         不然失去焦点前不会落盘（见 AGENTS.md 第 6 节第 10 条）。 -->
                    <controls:SettingsCard Description="右键「压缩」生成的 zip 保存到这个目录；留空则用「下载」文件夹" Header="压缩输出目录">
                        <!-- 用 Grid（而不是横着的 StackPanel）：路径框固定宽度在窄窗口里会把「浏览…」顶出卡片外、
                             按钮连点都点不到（卡片内容区在窗口较窄时会缩到 200 DIP 上下），
                             改成 * + Auto 两列后路径框跟着缩、按钮永远占着自己的位置。 -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="CompressionOutputBox"
                                Grid.Column="0"
                                AutomationProperties.Name="压缩输出目录"
                                PlaceholderText="留空 = 下载文件夹"
                                Text="{x:Bind ViewModel.CompressionOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="浏览压缩输出目录"
                                Click="BrowseCompressionOutput_Click"
                                Content="浏览…" />
                        </Grid>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 外观 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsAppearancePageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="外观" />

                    <!-- 主题是三态（跟随系统 / 浅色 / 深色），所以用下拉框；
                         标题栏左侧那个太阳 / 月亮图标是同一个设置的快捷入口（只在浅 / 深之间切）。 -->
                    <controls:SettingsCard Description="跟随系统（默认），或者固定用浅色 / 深色；也可以直接点标题栏左侧的太阳 / 月亮图标" Header="主题">
                        <ComboBox
                            MinWidth="120"
                            AutomationProperties.Name="主题"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="标签页顶部两个角用直角（更紧凑整齐）；关掉则用 Windows 默认的圆角" Header="标签页使用直角">
                        <ToggleSwitch
                            AutomationProperties.Name="标签页使用直角"
                            IsOn="{x:Bind ViewModel.SquareTabCorners, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="换目录与排序时播放列表入场 / 重排动画" Header="过渡动画">
                        <ToggleSwitch
                            AutomationProperties.Name="过渡动画"
                            IsOn="{x:Bind ViewModel.EnableListAnimations, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 布局 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsLayoutPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="布局" />

                    <controls:SettingsCard Description="关闭后列宽固定为拖动出来的值，装不下时横向滚动" Header="列宽自动适应窗格宽度">
                        <ToggleSwitch
                            AutomationProperties.Name="列宽自动适应窗格宽度"
                            IsOn="{x:Bind ViewModel.ColumnAutoFit, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="窗口顶部显示磁盘与固定目录工具条" Header="显示工具条">
                        <ToggleSwitch
                            AutomationProperties.Name="显示工具条"
                            IsOn="{x:Bind ViewModel.ShowToolbar, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="窗口左侧显示文件夹树" Header="显示侧边栏">
                        <ToggleSwitch
                            AutomationProperties.Name="显示侧边栏"
                            IsOn="{x:Bind ViewModel.ShowSidebar, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="左右并排两个窗格，各自拥有独立标签页与历史" Header="双窗格模式">
                        <ToggleSwitch
                            AutomationProperties.Name="双窗格模式"
                            IsOn="{x:Bind ViewModel.DualPane, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 启动 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsStartupPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="启动" />

                    <!-- 开机自启：登录时把进程起在后台备好（不显示主窗口），之后双击 exe / 点托盘图标几乎是瞬时的。 -->
                    <controls:SettingsCard Description="登录后在后台启动 exdir（不显示主窗口，只把上次的目录与首屏图标备好）；之后双击 exe / 点托盘图标几乎瞬时就能打开" Header="开机时自动启动 exdir">
                        <ToggleSwitch
                            AutomationProperties.Name="开机时自动启动 exdir"
                            IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 侧边栏 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsSidebarPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="侧边栏" />

                    <TextBlock
                        Margin="4,0,4,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="选择左侧文件夹树里显示哪几个分组（关掉只是不显示，不会丢掉已展开的目录与收藏）。"
                        TextWrapping="Wrap" />

                    <controls:SettingsCard Description="最近导航过的目录（最多 10 条），排在侧边栏最上面" Header="显示「最新访问」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「最新访问」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowRecent, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="用户主目录，以及桌面 / 文档 / 下载 / 图片等标准文件夹" Header="显示「主目录」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「主目录」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowHome, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="工具条上固定目录的镜像，也是把目录拖进侧边栏收藏的落点" Header="显示「收藏夹」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「收藏夹」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowFavorites, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="OneDrive / WPS 等同步根目录" Header="显示「云存储」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「云存储」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowCloud, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="本机各磁盘与其他已挂载的卷" Header="显示「此电脑」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「此电脑」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowComputer, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="SFTP / FTP 位置（在「远程」页里增删改）" Header="显示「远程」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「远程」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowRemote, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <TextBlock
                        Margin="4,12,4,4"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="「主目录」分组里显示哪些标准文件夹（只影响子项；分组本身由上面的开关控制）。"
                        TextWrapping="Wrap" />

                    <controls:SettingsCard Description="在「主目录」分组里显示“桌面”文件夹" Header="显示「桌面」">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「桌面」"
                            IsOn="{x:Bind ViewModel.SidebarHomeDesktop, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="在「主目录」分组里显示“文档”文件夹" Header="显示「文档」">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「文档」"
                            IsOn="{x:Bind ViewModel.SidebarHomeDocuments, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="在「主目录」分组里显示“下载”文件夹" Header="显示「下载」">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「下载」"
                            IsOn="{x:Bind ViewModel.SidebarHomeDownloads, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="在「主目录」分组里显示“图片”文件夹" Header="显示「图片」">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「图片」"
                            IsOn="{x:Bind ViewModel.SidebarHomePictures, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="在「主目录」分组里显示“音乐”文件夹" Header="显示「音乐」">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「音乐」"
                            IsOn="{x:Bind ViewModel.SidebarHomeMusic, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="在「主目录」分组里显示“视频”文件夹" Header="显示「视频」">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「视频」"
                            IsOn="{x:Bind ViewModel.SidebarHomeVideos, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 远程 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsRemotePageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="远程" />

                    <TextBlock
                        Margin="4,0,4,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="SFTP / FTP 位置会出现在侧边栏「远程」分组里，点一下就能浏览。密码与私钥口令用当前 Windows 用户的凭据加密后保存，config.json 里看不到明文。"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="4,0,4,8"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="还没有远程位置，点下面的「添加位置…」新建一个。"
                        Visibility="{x:Bind ViewModel.HasRemoteLocations, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                        TextWrapping="Wrap" />

                    <!-- 用 ItemsControl 不用 ListView：默认不虚拟化，所有行都在 UIA 树里（同右键菜单那页） -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RemoteLocationItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteLocationItemViewModel">
                                <controls:SettingsCard
                                    Margin="0,0,0,4"
                                    Description="{x:Bind Subtitle}"
                                    Header="{x:Bind Title}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Tag 是兜底：模板里 x:Bind 的 DataContext 不保证可用（见 AGENTS.md 第 7 条） -->
                                        <Button
                                            AutomationProperties.Name="{x:Bind EditButtonName, Mode=OneWay}"
                                            Click="EditRemoteLocation_Click"
                                            Content="编辑…"
                                            Tag="{x:Bind}" />
                                        <Button
                                            AutomationProperties.Name="{x:Bind DeleteButtonName, Mode=OneWay}"
                                            Click="DeleteRemoteLocation_Click"
                                            Content="删除"
                                            Tag="{x:Bind}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button
                        Margin="4,4,0,0"
                        AutomationProperties.Name="添加位置"
                        Click="AddRemoteLocation_Click"
                        Content="添加位置…" />
                </StackPanel>

                <!-- ============================ 右键菜单 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsShellMenuPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="右键菜单" />

                    <!-- 菜单风格：内置菜单是 exdir 自己用 MenuFlyout 现搭的（弹出几乎瞬时），
                         系统菜单要现场建 IContextMenu（内容完整但慢）；两者内容不要求一致。 -->
                    <controls:SettingsCard Description="内置菜单弹出几乎瞬时，只含打开 / 复制路径 / 新建文件夹等 exdir 自己的常用命令；关掉则用系统菜单（含第三方扩展，但弹出较慢）" Header="使用内置的轻量右键菜单">
                        <ToggleSwitch
                            AutomationProperties.Name="使用内置的轻量右键菜单"
                            IsOn="{x:Bind ViewModel.UseBuiltInContextMenu, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <!-- 把系统菜单里的项平铺合并进内置菜单：内容完整（含 7-Zip / Git / 发送到），
                         但读一遍要把第三方 shell 扩展 Load 进本进程，弹出会与系统菜单一样慢，所以默认关。 -->
                    <controls:SettingsCard Description="在内置菜单末尾接上外壳当前的菜单项（含 7-Zip / Git / 发送到 / 重命名这类 exdir 自己没实现的），按动词去重；读一遍要把第三方扩展加载进本进程，弹出与系统菜单一样慢" Header="在内置菜单里合并系统菜单项">
                        <ToggleSwitch
                            AutomationProperties.Name="在内置菜单里合并系统菜单项"
                            IsOn="{x:Bind ViewModel.BuiltInMenuIncludeShellItems, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <TextBlock
                        Margin="4,0,4,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="下面列出系统右键菜单里的项（含第三方扩展），关掉的项不会出现在系统菜单里；开启上面那个「在内置菜单里合并系统菜单项」后，这份清单也会作用于内置菜单。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="4,0,4,8"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="正在读取系统右键菜单项…"
                        Visibility="{x:Bind ViewModel.HasShellMenuItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- 用 ItemsControl 而不是 ListView：默认不虚拟化，所有行都在可视树 / UIA 树里，
                         回归脚本能一次数完（ListView 把没显示出来的行虚拟化掉，就数不到了）。 -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ShellMenuItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShellMenuItemViewModel">
                                <controls:SettingsCard
                                    Margin="0,0,0,4"
                                    Description="{x:Bind Description}"
                                    Header="{x:Bind Title}">
                                    <ToggleSwitch
                                        AutomationProperties.Name="{x:Bind Title}"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent="" />
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<!--
  设置窗口的正文：左侧 NavigationView 选分类，右侧一列 Windows 11 风格的设置卡片
  （CommunityToolkit 的 SettingsCard：标题 + 灰色说明 + 右侧控件），不再自己写行模板 ——
  间距、圆角、悬停、高对比主题都跟着系统走。分类页用 Visibility 切换（非当前页 UIA 树里也读不到）。

  为什么正文是 UserControl 而不是直接写在 Window 里：
  1. Window 不是 FrameworkElement，WinUI 生成的 x:Bind 代码在 Window 这一层做不了
     {StaticResource} 转换器查找（编译期直接报 CS1503），而窗口正文到处要用 BoolToVisibility；
  2. 与仓库里其它 UserControl 一致：ViewModel 是依赖属性，由父级赋值。
-->
<UserControl
    x:Class="Exdir.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="Nav"
        CompactPaneLength="48"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        MenuItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
        OpenPaneLength="180"
        PaneDisplayMode="Left"
        SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItemTemplate>
            <!-- NavigationView 的菜单项模板根必须是 NavigationViewItem（和 TabView / TreeView 同理） -->
            <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                <NavigationViewItem Content="{x:Bind Name}" />
            </DataTemplate>
        </NavigationView.MenuItemTemplate>

        <ScrollViewer Padding="24,8,24,24" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- ============================ 文件列表 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsFileListPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="文件列表" />

                    <controls:SettingsCard Description="显示以 . 开头、带隐藏或系统属性的项目" Header="显示隐藏文件">
                        <ToggleSwitch
                            AutomationProperties.Name="显示隐藏文件"
                            IsOn="{x:Bind ViewModel.ShowHiddenFiles, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="在文件名后显示 .txt / .png 等扩展名" Header="显示文件扩展名">
                        <ToggleSwitch
                            AutomationProperties.Name="显示文件扩展名"
                            IsOn="{x:Bind ViewModel.ShowExtensions, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="排序时文件夹始终排在文件之前" Header="文件夹排在文件前面">
                        <ToggleSwitch
                            AutomationProperties.Name="文件夹排在文件前面"
                            IsOn="{x:Bind ViewModel.FoldersFirst, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <!-- 行高是连续值，用滑块；右侧常驻当前数值（UIA 名字就是数字本身） -->
                    <controls:SettingsCard Description="文件列表每一行的高度；图标与名称始终在行内垂直居中" Header="行高">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider
                                x:Name="RowHeightSlider"
                                Width="160"
                                AutomationProperties.Name="行高"
                                IsThumbToolTipEnabled="False"
                                Maximum="{x:Bind ViewModel.RowHeightMaximum, Mode=OneWay}"
                                Minimum="{x:Bind ViewModel.RowHeightMinimum, Mode=OneWay}"
                                StepFrequency="{x:Bind ViewModel.RowHeightStep, Mode=OneWay}"
                                Value="{x:Bind ViewModel.RowHeight, Mode=TwoWay}" />
                            <TextBlock
                                x:Name="RowHeightValue"
                                Width="24"
                                VerticalAlignment="Center"
                                TextAlignment="Right" />
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 外观 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsAppearancePageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="外观" />

                    <controls:SettingsCard Description="标签页顶部两个角用直角（更紧凑整齐）；关掉则用 Windows 默认的圆角" Header="标签页使用直角">
                        <ToggleSwitch
                            AutomationProperties.Name="标签页使用直角"
                            IsOn="{x:Bind ViewModel.SquareTabCorners, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="换目录与排序时播放列表入场 / 重排动画" Header="过渡动画">
                        <ToggleSwitch
                            AutomationProperties.Name="过渡动画"
                            IsOn="{x:Bind ViewModel.EnableListAnimations, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 布局 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsLayoutPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="布局" />

                    <controls:SettingsCard Description="关闭后列宽固定为拖动出来的值，装不下时横向滚动" Header="列宽自动适应窗格宽度">
                        <ToggleSwitch
                            AutomationProperties.Name="列宽自动适应窗格宽度"
                            IsOn="{x:Bind ViewModel.ColumnAutoFit, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="窗口顶部显示磁盘与固定目录工具条" Header="显示工具条">
                        <ToggleSwitch
                            AutomationProperties.Name="显示工具条"
                            IsOn="{x:Bind ViewModel.ShowToolbar, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="窗口左侧显示文件夹树" Header="显示侧边栏">
                        <ToggleSwitch
                            AutomationProperties.Name="显示侧边栏"
                            IsOn="{x:Bind ViewModel.ShowSidebar, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="左右并排两个窗格，各自拥有独立标签页与历史" Header="双窗格模式">
                        <ToggleSwitch
                            AutomationProperties.Name="双窗格模式"
                            IsOn="{x:Bind ViewModel.DualPane, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 侧边栏 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsSidebarPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="侧边栏" />

                    <TextBlock
                        Margin="4,0,4,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="选择左侧文件夹树里显示哪几个分组（关掉只是不显示，不会丢掉已展开的目录与收藏）。"
                        TextWrapping="Wrap" />

                    <controls:SettingsCard Description="用户主目录，以及桌面 / 文档 / 下载 / 图片等标准文件夹" Header="显示「主目录」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「主目录」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowHome, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="工具条上固定目录的镜像，也是把目录拖进侧边栏收藏的落点" Header="显示「收藏夹」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「收藏夹」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowFavorites, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="OneDrive / WPS 等同步根目录" Header="显示「云存储」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「云存储」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowCloud, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="本机各磁盘与其他已挂载的卷" Header="显示「此电脑」分组">
                        <ToggleSwitch
                            AutomationProperties.Name="显示「此电脑」分组"
                            IsOn="{x:Bind ViewModel.SidebarShowComputer, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ============================ 右键菜单 ============================ -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsShellMenuPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="4,0,0,12"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="右键菜单" />

                    <!-- 菜单风格：内置菜单是 exdir 自己用 MenuFlyout 现搭的（弹出几乎瞬时），
                         系统菜单要现场建 IContextMenu（内容完整但慢）；两者内容不要求一致。 -->
                    <controls:SettingsCard Description="内置菜单弹出几乎瞬时，只含打开 / 复制路径 / 新建文件夹等 exdir 自己的常用命令；关掉则用系统菜单（含第三方扩展，但弹出较慢）" Header="使用内置的轻量右键菜单">
                        <ToggleSwitch
                            AutomationProperties.Name="使用内置的轻量右键菜单"
                            IsOn="{x:Bind ViewModel.UseBuiltInContextMenu, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </controls:SettingsCard>

                    <TextBlock
                        Margin="4,0,4,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="下面列出系统右键菜单里的项（含第三方扩展），关掉的项不会再出现在系统菜单里；内置菜单不使用这份清单。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="4,0,4,8"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="正在读取系统右键菜单项…"
                        Visibility="{x:Bind ViewModel.HasShellMenuItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- 用 ItemsControl 而不是 ListView：默认不虚拟化，所有行都在可视树 / UIA 树里，
                         回归脚本能一次数完（ListView 把没显示出来的行虚拟化掉，就数不到了）。 -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ShellMenuItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShellMenuItemViewModel">
                                <controls:SettingsCard
                                    Margin="0,0,0,4"
                                    Description="{x:Bind Description}"
                                    Header="{x:Bind Title}">
                                    <ToggleSwitch
                                        AutomationProperties.Name="{x:Bind Title}"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent="" />
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</UserControl>

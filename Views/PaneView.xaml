<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Exdir.Views.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Exdir.Views"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="PaneRoot"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="Transparent"
        BorderThickness="1"
        GotFocus="PaneRoot_GotFocus"
        PointerPressed="PaneRoot_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 导航条 ================= -->
        <Grid
            Grid.Row="0"
            Height="30"
            Padding="4,0,6,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                <Button
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ActiveTab.GoBackCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="后退 (Alt+←)">
                    <FontIcon FontSize="13" Glyph="&#xE72B;" />
                </Button>
                <Button
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ActiveTab.GoForwardCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="前进 (Alt+→)">
                    <FontIcon FontSize="13" Glyph="&#xE72A;" />
                </Button>
                <Button
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ActiveTab.GoUpCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="上一级 (Alt+↑)">
                    <FontIcon FontSize="13" Glyph="&#xE74A;" />
                </Button>
                <Button
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ActiveTab.RefreshCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="刷新 (F5)">
                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>

            <TextBox
                x:Name="PathBox"
                Grid.Column="1"
                Height="24"
                Padding="8,0,8,0"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="12"
                IsSpellCheckEnabled="False"
                KeyDown="PathBox_KeyDown"
                PlaceholderText="输入路径后按回车"
                Text="{x:Bind ViewModel.ActiveTab.PathInput, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.ActiveTab.TooltipText, Mode=OneWay}" />
        </Grid>

        <!-- ================= 标签页 ================= -->
        <TabView
            x:Name="Tabs"
            Grid.Row="1"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            CanDragTabs="False"
            CanReorderTabs="True"
            CloseButtonOverlayMode="OnPointerOver"
            IsAddTabButtonVisible="True"
            SelectedItem="{x:Bind ViewModel.ActiveTab, Mode=TwoWay}"
            TabCloseRequested="Tabs_TabCloseRequested"
            TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
            TabWidthMode="SizeToContent">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:FolderTabViewModel">
                    <TabViewItem
                        Header="{x:Bind TabHeader, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
                        <TabViewItem.IconSource>
                            <FontIconSource FontSize="13" Glyph="&#xE8B7;" />
                        </TabViewItem.IconSource>
                        <views:DetailsView ViewModel="{x:Bind}" />
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Exdir.Views.PathBreadcrumb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        地址栏 = 面包屑 + 可编辑输入框（二者互斥，由 ViewModel.IsPathEditing 决定）。
        * 面包屑：路径分段之间用 chevron 分隔，点分段跳转，点“当前目录”段进编辑态；
        * 空白区域（分段右侧/下方、chevron 之间）点击 = 进编辑态，输入框铺满整条地址栏，
          回车前往、Esc 或失焦取消。
    -->
    <Grid x:Name="AddressHost" Background="Transparent" Tapped="AddressHost_Tapped">
        <!-- 面包屑：内容超宽时滚到最右（当前目录永远可见），左侧用省略号提示被裁掉的部分 -->
        <ScrollViewer
            x:Name="CrumbScroll"
            Padding="4,0,0,0"
            HorizontalAlignment="Stretch"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            SizeChanged="CrumbScroll_SizeChanged"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ViewChanged="CrumbScroll_ViewChanged">
            <ItemsControl
                x:Name="Crumbs"
                HorizontalAlignment="Left"
                ItemsSource="{x:Bind ViewModel.PathSegments, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PathSegmentViewModel">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <FontIcon
                                Margin="1,0"
                                VerticalAlignment="Center"
                                FontSize="8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;"
                                Visibility="{x:Bind IsFirst, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button
                                Height="22"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                Click="Segment_Click"
                                Content="{x:Bind DisplayName}"
                                FontSize="12"
                                Style="{StaticResource ExSubtleButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind Tooltip}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 路径超长时遮掉滚出去的部分（背景色与导航条一致，所以看起来像渐隐） -->
        <Border
            x:Name="OverflowIndicator"
            Padding="2,0,6,0"
            HorizontalAlignment="Left"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="&#x2026;" />
        </Border>

        <!-- 右侧空白区（面包屑之后到地址栏右边界）的点击目标：点它切到编辑态。
             位置/宽度由 code-behind 按面包屑实际宽度算出来（见 UpdateBlankArea），
             放在 ScrollViewer 之上，避免被 ScrollViewer 吃掉点击。 -->
        <Button
            x:Name="BlankArea"
            Width="0"
            MinWidth="0"
            MinHeight="0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="地址栏空白区"
            Click="BlankArea_Click"
            IsTabStop="False"
            Style="{StaticResource ExSubtleButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipText, Mode=OneWay}"
            Visibility="Collapsed" />

        <!-- 编辑态：不设 Height，只给上下对称的 Padding（见 AGENTS 坑 12） -->
        <TextBox
            x:Name="PathBox"
            Padding="{StaticResource ExTextControlPadding}"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            AutomationProperties.Name="路径"
            FontSize="12"
            IsSpellCheckEnabled="False"
            KeyDown="PathBox_KeyDown"
            LostFocus="PathBox_LostFocus"
            PlaceholderText="输入路径后按回车"
            Text="{x:Bind ViewModel.PathInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>

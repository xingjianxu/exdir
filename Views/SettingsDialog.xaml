<?xml version="1.0" encoding="utf-8"?>
<!--
  统一的设置对话框：左侧是配置大类的导航列表（文件列表 / 外观 / 布局），右侧是当前大类的正文。
  底部固定「保存 / 取消」两个按钮（ContentDialog 的 PrimaryButton / CloseButton 就是画在底部）。
  内容绑定的是 SettingsViewModel 快照，只有「保存」才会写回并落盘。
-->
<ContentDialog
    x:Class="Exdir.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Exdir.Views"
    xmlns:vm="using:Exdir.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="设置"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="保存"
    Title="设置">

    <ContentDialog.Resources>
        <!--
            ContentDialog 默认最宽只有 548 DIP、最窄 320 DIP，一栏内容够用，装不下“导航 + 正文”两栏，
            所以这里放宽。
        -->
        <x:Double x:Key="ContentDialogMinWidth">520</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>

        <!--
            与主窗口一致：只靠整行底色表示选中，不要 ListViewItem 左侧那条强调色竖条。
            Themes/ExdirTheme.xaml 里已经关过一次（主窗口的文件列表确实没有竖条），
            但在 ContentDialog 里的 ListViewItemPresenter 拿不到那个值，实测仍会画出来，
            所以在这个作用域再关一次（见 AGENTS.md 第 6 节第 38 条）。
        -->
        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
    </ContentDialog.Resources>

    <!--
        MinHeight 而不是 Height：正文最矮的分类（外观只有一行）也保持同样的对话框高度，
        切换分类时窗口不跳动；高度本身仍受 ContentDialog 模板的 `*` 行约束，
        窗口太矮时右侧的 ScrollViewer 会自己出现滚动条。
        两列都是固定宽度：星号列不参与 DesiredSize 计算，让对话框宽度由“导航 + 正文”定死，
        否则三个页面里最长的说明文字会把对话框撑成三种宽度，切分类时两边一起闪。
    -->
    <Grid MinHeight="250">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="156" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ============================ 左侧：配置大类导航 ============================ -->
        <ListView
            x:Name="CategoryList"
            Grid.Column="0"
            Padding="4,8,4,8"
            AutomationProperties.Name="设置分类"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ItemsSource="{x:Bind ViewModel.Categories}"
            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <!-- 必须 BasedOn：ListViewItem 的 ControlTemplate 就在这个隐式样式里 -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="Padding" Value="10,0,8,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ============================ 右侧：当前分类的正文 ============================ -->
        <Border
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer
                Padding="20,4,8,16"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!-- 三个页面都在这里，按左侧选中的分类只显示一个（其余的 Visibility=Collapsed，UIA 里也读不到） -->
                <Grid>

                    <!-- 文件列表 -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsFileListPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="文件列表" />
                        <views:SettingsToggleRow
                            Title="显示隐藏文件"
                            Description="显示以 . 开头、带隐藏或系统属性的项目"
                            IsOn="{x:Bind ViewModel.ShowHiddenFiles, Mode=TwoWay}" />
                        <views:SettingsToggleRow
                            Title="显示文件扩展名"
                            Description="在文件名后显示 .txt / .png 等扩展名"
                            IsOn="{x:Bind ViewModel.ShowExtensions, Mode=TwoWay}" />
                        <views:SettingsToggleRow
                            Title="文件夹排在文件前面"
                            Description="排序时文件夹始终排在文件之前"
                            IsOn="{x:Bind ViewModel.FoldersFirst, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 外观 -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsAppearancePageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="外观" />
                        <views:SettingsToggleRow
                            Title="过渡动画"
                            Description="换目录与排序时播放列表入场 / 重排动画"
                            IsOn="{x:Bind ViewModel.EnableListAnimations, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 布局 -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsLayoutPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="布局" />
                        <views:SettingsToggleRow
                            Title="列宽自动适应窗格宽度"
                            Description="关闭后列宽固定为拖动出来的值，装不下时横向滚动"
                            IsOn="{x:Bind ViewModel.ColumnAutoFit, Mode=TwoWay}" />
                        <views:SettingsToggleRow
                            Title="显示工具条"
                            Description="窗口顶部显示磁盘与固定目录工具条"
                            IsOn="{x:Bind ViewModel.ShowToolbar, Mode=TwoWay}" />
                        <views:SettingsToggleRow
                            Title="显示侧边栏"
                            Description="窗口左侧显示文件夹树"
                            IsOn="{x:Bind ViewModel.ShowSidebar, Mode=TwoWay}" />
                        <views:SettingsToggleRow
                            Title="双窗格模式"
                            Description="左右并排两个窗格，各自拥有独立标签页与历史"
                            IsOn="{x:Bind ViewModel.DualPane, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 右键菜单 -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsShellMenuPageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="右键菜单" />
                        <TextBlock
                            Margin="0,0,0,4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="这里列出系统右键菜单里的项（含第三方扩展），关掉的项不会再出现在文件列表的右键菜单里。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,4"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="正在读取系统右键菜单项…"
                            Visibility="{x:Bind ViewModel.HasShellMenuItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- 用 ItemsControl 而不是 ListView：默认不虚拟化，所有行都在可视树 / UIA 树里，
                             回归脚本能一次数完（ListView 把没显示出来的行虚拟化掉，就数不到了）。 -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ShellMenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShellMenuItemViewModel">
                                    <views:SettingsToggleRow
                                        Title="{x:Bind Title}"
                                        Description="{x:Bind Description}"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</ContentDialog>

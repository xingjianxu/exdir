<Project Sdk="Microsoft.NET.Sdk">

  <!--
    压缩包只读浏览的**服务级**冒烟测试（不需要交互桌面，见 AGENTS.md 第 2 节）：
    直接把 app 里那几个源文件编进来跑真实实现，覆盖 7z.dll 互操作 / 路径解析 / 枚举 /
    解到临时目录 / tar.gz 链式解开 / 加密包 / 损坏包 / 缓存失效 / 取消 / 临时目录清理。
    交互部分（双击进包、只读守卫、真鼠标）在 tools\test-archive.ps1 里，那个需要交互桌面。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>archive-smoke</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Services\IArchiveService.cs" />
    <Compile Include="..\..\Services\ArchiveService.cs" />
    <Compile Include="..\..\Services\Native\SevenZipInterop.cs" />
    <Compile Include="..\..\Models\ArchivePath.cs" />
    <Compile Include="..\..\Models\FileSystemEntry.cs" />
    <Compile Include="..\..\Models\CloudSyncState.cs" />
    <Compile Include="..\..\Helpers\ArchiveFormats.cs" />
    <Compile Include="..\..\Helpers\FileTypeHelper.cs" />
    <Compile Include="..\..\Diagnostics\Log.cs" />
    <None Include="..\..\native\x64\7z.dll" Link="7z.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
